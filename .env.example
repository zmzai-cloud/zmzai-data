# ---------- 服务鉴权（调用方必须带 Bearer service-key） ----------
# 当前生效的密钥；轮换期可同时配置 PREVIOUS，两者都接受。
DATA_SERVICE_KEY_CURRENT=
DATA_SERVICE_KEY_PREVIOUS=

# ---------- A股数据源：Tushare Pro ----------
# 未配置时 A股接口返回 503 + 明确提示（不静默降级），加密数据源不受影响。
TUSHARE_TOKEN=
TUSHARE_API_URL=http://api.waditu.com

# ---------- 加密数据源：Binance 公开 REST（USDT 现货） ----------
# 主域名不可达（部分区域被墙）时自动降级到 BINANCE_FALLBACK_BASES（逗号分隔）。
BINANCE_API_BASE=https://api.binance.com
BINANCE_FALLBACK_BASES=https://data-api.binance.vision

# ---------- 缓存 / 限频 ----------
# 历史日线长缓存 6h；含当日数据的窗口 60s（盘中会变）
CACHE_HISTORY_TTL_MS=21600000
CACHE_TODAY_TTL_MS=60000
# token bucket：每源每秒补充的令牌数（尊重源站速率）
RATE_LIMIT_TUSHARE_RPS=2
RATE_LIMIT_BINANCE_RPS=10
# 上游 HTTP 超时
HTTP_TIMEOUT_MS=10000
